{
  "name": "@local-hosting/compose",
  "packageManager": "yarn@4.18.1",
  "version": "0.1.0",
  "private": true,
  "description": "Non-AI compose: lexicon/rules + languages → CompactFrame via @local-hosting/frames.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./thin": {
      "types": "./dist/thin/index.d.ts",
      "import": "./dist/thin/index.js",
      "default": "./dist/thin/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "yarn typecheck",
    "test": "vitest run",
    "pretest": "yarn build",
    "ci": "yarn validate && yarn build && yarn test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@local-hosting/comms": "0.3.0",
    "@local-hosting/frames": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
