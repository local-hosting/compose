{
  "name": "@local-hosting/compose",
  "packageManager": "yarn@4.18.1",
  "version": "0.1.0",
  "description": "Non-AI compose: lexicon/rules + languages → CompactFrame via @local-hosting/frames.",
  "type": "module",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local-hosting/compose.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./thin": {
      "types": "./dist/thin/index.d.ts",
      "import": "./dist/thin/index.js",
      "default": "./dist/thin/index.js"
    },
    "./messages": {
      "types": "./dist/messages/index.d.ts",
      "import": "./dist/messages/index.js",
      "default": "./dist/messages/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "messages",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "yarn typecheck",
    "test": "vitest run",
    "pretest": "yarn build",
    "ci": "yarn validate && yarn build && yarn test",
    "prepublishOnly": "yarn build",
    "publish:package": "npm publish --registry=https://npm.pkg.github.com",
    "test:watch": "vitest",
    "messages:resilience:synthetic": "node scripts/generate-resilience-synthetic.mjs && node scripts/annotate-resilience-synthetic-geo.mjs",
    "messages:resilience:crisislex": "node scripts/import-crisislex.mjs"
  },
  "dependencies": {
    "@local-hosting/comms": "0.3.0",
    "@local-hosting/frames": "0.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}